{
  "name": "ai-assistant",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n agent,web,files -c blue,magenta,green \"npm:dev:agent\" \"npm:dev:web\" \"npm:dev:files\"",
    "dev:agent": "npm run dev -w agent",
    "dev:web": "npm run dev -w frontend",
    "dev:files": "npm run dev -w file-storage",
    "typecheck": "npm run typecheck -w agent && npm run typecheck -w frontend && npm run typecheck -w file-storage && npm run typecheck -w mcp-authoring && npm run typecheck -w @ai-assistant/shared-node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/frontend",
    "apps/agent",
    "apps/file-storage",
    "apps/mcp-authoring",
    "packages/*"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@types/node": "^24"
  }
}
